# ──────────────────────────────────────────────────────────────
# Global base flags (apply everywhere unless overridden)
# ──────────────────────────────────────────────────────────────
CompileFlags:
  Add:
    - -std=c++17
    - -x
    - c++
    - -I.
    - -Iidlib
    - -Igame
    - -Iengine
    - -Iengine/framework
    - -Iengine/renderer
    - -Iengine/sys
    - -Iextern/imgui
    - -Iextern/nvrhi/include
    - -D_DEBUG
    - -DUNICODE
    - -D_UNICODE
    - -D_WIN32
    - -DWIN32
    - -D_WINDOWS
    - -D__DOOM_DLL__
  Remove:
    # Strip MSVC-specific flags that clang doesn't understand
    - /EH*
    - /W*
    - /wd*
    - /Zi
    - /ZI
    - /GR
    - /Gm*
    - /MP
    - /fp:*
    - /Yu*
    - /Yc*
    - /Fp*
    - /permissive*


# ──────────────────────────────────────────────────────────────
# engine, tools, idlib: only the two precompiled headers
#
# compile_commands.json uses clang-cl (--driver-mode=cl) so we
# must use /FI (MSVC forced include) instead of -include.
# ──────────────────────────────────────────────────────────────
---
If:
  PathMatch: [engine/.*, tools/.*, idlib/.*]
CompileFlags:
  Add:
    - /FIidlib/precompiled.h
    - /FIgame/precompiled.h


# ──────────────────────────────────────────────────────────────
# game/: precompiled headers + Game_local.h
#
# Every game .cpp does:
#   #include "precompiled.h"
#   #include "Game_local.h"          (or "../Game_local.h")
#
# Game_local.h pulls in Entity.h, AFEntity.h, Player.h, etc.
# Without it clangd cannot resolve idAnimatedEntity and friends.
# ──────────────────────────────────────────────────────────────
---
If:
  PathMatch: [game/.*]
CompileFlags:
  Add:
    - /FIidlib/precompiled.h
    - /FIgame/precompiled.h
    - /FIgame/Game_local.h


# ──────────────────────────────────────────────────────────────
# External / third-party code should NOT get forced PCH
# ──────────────────────────────────────────────────────────────
---
If:
  PathMatch: [libs/.*, extern/.*]
CompileFlags:
  Remove:
    - /FI*

Diagnostics:
  ClangTidy:
    Add: []
  UnusedIncludes: None
