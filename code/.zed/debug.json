[
  {
    "label": "Roguestrad: Debug Linux (CodeLLDB)",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/build/Debug/Roguestrad",
    "cwd": "$ZED_WORKTREE_ROOT/..",
    "args": ["+set", "logfile", "2"],
  },
  {
    "label": "Roguestrad: Debug EXE (CodeLLDB)",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT\\build\\Debug\\Roguestrad.exe",
    "cwd": "$ZED_WORKTREE_ROOT\\..",
    "args": ["+set", "logfile", "2", "+set", "fs_game", "content"],
    "env": {
      "_NO_DEBUG_HEAP": "1",
    },
  },
  {
    "label": "Roguestrad: Debug Optimized EXE (CodeLLDB)",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT\\build\\RelWithDebInfo\\Roguestrad.exe",
    "cwd": "$ZED_WORKTREE_ROOT\\..",
    "args": ["+set", "logfile", "2", "+set", "fs_game", "mod_swftests"],
    "env": {
      "_NO_DEBUG_HEAP": "1",
    },
  },
  {
    "label": "Roguestrad: Debug Release EXE (CodeLLDB)",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT\\build\\Release\\Roguestrad.exe",
    "cwd": "$ZED_WORKTREE_ROOT\\..",
    "args": ["+set", "logfile", "2", "+set", "fs_game", "mod_swfss2"],
    "env": {
      "_NO_DEBUG_HEAP": "1",
    },
  },
]
